rules_version = '2';

// -----------------------------------------------------------------------------
// Barbería — Reglas de seguridad Firestore
//
// Modelo de roles:
//   - client   → usuario final que reserva (web + móvil)
//   - barber   → empleado; ve su agenda y citas asignadas
//   - admin    → dueño; gestiona servicios, barberos, precios, config
//
// Notas:
//   - El rol NO se asigna por orden de registro. Se crea como 'client' por
//     defecto. Admin/barber se promueven manualmente desde un admin existente.
//   - Colecciones "futuras" (schedule_blocks, walkins, reputation, config)
//     ya quedan definidas aquí para evitar re-deploys al activar cada fase.
//   - Cualquier cosa no contemplada se deniega explícitamente al final.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == role;
    }

    function isAdmin()  { return hasRole('admin'); }
    function isBarber() { return hasRole('barber'); }
    function isStaff()  { return isAdmin() || isBarber(); }

    function isOwnerOf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users ---------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwnerOf(userId) || isStaff() || resource.data.role == 'barber';

      // Alta: el propio usuario y SOLO como 'client'
      allow create: if isOwnerOf(userId)
                    && request.resource.data.role == 'client';

      // Update propio: no puede cambiarse el rol a sí mismo
      allow update: if isOwnerOf(userId)
                    && request.resource.data.role == resource.data.role;

      // Admin puede todo (crear barbero/staff, promover rol, asignar barbero, etc.)
      allow create, update, delete: if isAdmin();
    }

    // ---------- services (catálogo público) -----------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- bookings ------------------------------------------------------
    //
    // CREATE:
    //   Denegado para client/barber. La puerta normal de escritura es la
    //   Cloud Function `reserveSlot` (Admin SDK, bypasea estas reglas) que
    //   ejecuta la transacción anti-colisión del motor de slots — un
    //   cliente nunca puede crear un booking "a mano" saltándose esa
    //   validación.
    //   Excepción: isAdmin() SÍ puede crear directo, para el flujo de
    //   "reserva manual / walk-in" del admin portal
    //   (admin_portal_page.dart ~línea 3709). Es una concesión deliberada:
    //   el admin es un rol de confianza y necesita poder registrar citas
    //   tomadas por teléfono/en persona sin pasar por el picker de
    //   disponibilidad. TODO: ese formulario hoy escribe campos legacy
    //   (clientName/barberName/time) en vez del esquema v2
    //   (userId/barberId/serviceId/startAt/endAt) — no colisiona con el
    //   motor de slots de `reserveSlot` porque le faltan esos campos.
    //   Migrar ese formulario a un schema v2 completo (o a su propia
    //   Cloud Function) es un pendiente, no algo que romperá la demo.
    //
    // READ:
    //   Solo el dueño autenticado (userId == auth.uid), el barbero asignado,
    //   o staff. Un cliente NO puede listar/leer citas de otros clientes.
    //   Nota: las reservas de invitados (`userId == 'guest'`) no son legibles
    //   por el cliente vía SDK — eso es intencional; el cliente recibe el
    //   `bookingId` como valor de retorno de `reserveSlot` y lo persiste
    //   localmente (shared_preferences) si necesita re-mostrarlo.
    //
    // UPDATE:
    //   El dueño puede actualizar SOLO para cancelar (ver `_isOwnerCancelOnly`
    //   abajo) — no puede tocar precio, horario ni barbero asignado. El
    //   barbero asignado y staff pueden actualizar status/notes libremente.
    //   DELETE queda solo para admin.
    // ------------------------------------------------------------------------
    function _isOwnerCancelOnly() {
      return isOwnerOf(resource.data.userId)
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelReason', 'updatedAt']);
    }

    match /bookings/{bookingId} {
      allow read: if isStaff()
                  || isOwnerOf(resource.data.userId)
                  || (isBarber() && resource.data.barberId == request.auth.uid);

      allow create: if isAdmin();

      allow update: if isStaff()
                    || (isBarber() && resource.data.barberId == request.auth.uid)
                    || _isOwnerCancelOnly();

      allow delete: if isAdmin();
    }

    // ---------- schedule_blocks (comida, descanso, vacaciones) ----------------
    match /schedule_blocks/{blockId} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        || (isBarber() && request.resource.data.barberId == request.auth.uid);
      allow delete: if isAdmin()
        || (isBarber() && resource.data.barberId == request.auth.uid);
    }
    // ---------- walkins (cola sin cita) ---------------------------------------
    match /walkins/{walkinId} {
      allow read, write: if isStaff();
    }

    // ---------- reputation (anti no-show, key = teléfono normalizado) ---------
    match /reputation/{phone} {
      allow read, write: if isStaff();
    }

    // ---------- clients (notas persistentes por cliente) ----------------------
    // clients/{key} guarda notas de visita, keyed por email normalizado en
    // minusculas o, si no hay email, por nombre en minusculas (_clientKeyFor).
    match /clients/{clientKey} {
      allow read, write: if isStaff();
    }
    // ---------- config (horarios, dirección, parámetros globales) -------------
    match /config/{docId} {
      allow read: if true;           // público para mostrar horarios en la web
      allow write: if isAdmin();
    }

    // ---------- admin_notifications ------------------------------------------
    match /admin_notifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if isBarber()
                    && request.resource.data.type == 'barber_active'
                    && request.resource.data.barberId == request.auth.uid
                    && request.resource.data.read == false;
    }

    // ---------- notifications -------------------------------------------------
    //
    // CREATE: denegado por SDK de cliente. `reserveSlot` crea la notificación
    // de "nueva cita" en la misma transacción del booking (Admin SDK).
    // READ/UPDATE: solo staff (el admin/barber portal marca `read: true`).
    // ------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read, update: if isStaff();
      allow create, delete: if false;
    }

    // ---------- default deny --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
