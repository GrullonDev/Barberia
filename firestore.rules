rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function staff(shopId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return shopId is string && shopId.size() > 0
        && profile.shopId == shopId && profile.role in ['barber', 'admin'];
    }

    function admin(shopId) {
      return staff(shopId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function sameTenantUpdate() {
      return staff(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow write: if admin(shopId);
    }

    // Public projections are replaced by the server using a field allowlist.
    match /barber_directory/{barberId} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if own(uid) || admin(resource.data.shopId);
      allow create: if own(uid) && request.resource.data.role == 'client'
        && request.resource.data.get('shopId', null) == null;
      allow update: if (own(uid)
        && changesOnly(['name', 'phone', 'phoneNormalized', 'photoUrl', 'bio',
                        'specialty', 'specialties', 'availability', 'isAvailable', 'mustChangePassword']))
        || (admin(resource.data.shopId) && resource.data.role == 'barber'
          && changesOnly(['name', 'photoUrl', 'specialty', 'bio', 'isAvailable', 'workingHours']));
    }

    match /services/{id} {
      allow read: if true;
      allow create: if admin(request.resource.data.shopId);
      allow update: if admin(resource.data.shopId) && sameTenantUpdate();
      allow delete: if admin(resource.data.shopId);
    }

    match /bookings/{id} {
      function assignedStaff() {
        return admin(resource.data.shopId)
          || (own(resource.data.barberId) && staff(resource.data.shopId));
      }
      // Every status change names its author; onBookingNoShow copies it into
      // reputation_events as the audit trail.
      function statusAudited() {
        return request.resource.data.status == resource.data.status
          || request.resource.data.get('statusChangedBy', null) == request.auth.uid;
      }
      allow read: if own(resource.data.get('userId', null)) || assignedStaff();
      // Occupancy, assignment, and pricing are owned by the booking callables.
      allow update: if statusAudited() && ((assignedStaff() && changesOnly(['status', 'notes', 'checkedIn',
                            'serviceStartedAt', 'cancelReason', 'updatedAt', 'statusChangedBy'])
          && (request.resource.data.status == resource.data.status
              || resource.data.status.lower() in ['pending', 'confirmed', 'live', 'inprogress'])
          && request.resource.data.status.lower() in ['pending', 'confirmed', 'live', 'inprogress',
                              'completed', 'finished', 'cancelled', 'noshow', 'no_show'])
        || (own(resource.data.get('userId', null))
          && resource.data.status.lower() in ['pending', 'confirmed']
          && request.resource.data.status.lower() == 'cancelled'
          && changesOnly(['status', 'cancelReason', 'updatedAt', 'statusChangedBy'])));
    }

    match /schedule_blocks/{id} {
      function manages(data) {
        return admin(data.shopId) || (staff(data.shopId) && own(data.barberId));
      }
      allow read: if staff(resource.data.shopId);
      // Creating or editing a block can make booked time unavailable, so it
      // goes through the createScheduleBlock callable, which takes the same
      // per-day guards as reserveSlot. Deleting only frees time.
      allow create, update: if false;
      allow delete: if manages(resource.data);
    }

    match /{collection}/{id} {
      allow read, delete: if collection in ['walkins', 'clients'] && staff(resource.data.shopId);
      allow create: if collection in ['walkins', 'clients'] && staff(request.resource.data.shopId);
      allow update: if collection in ['walkins', 'clients'] && sameTenantUpdate();
    }

    match /reputation/{phone} {
      allow read: if staff(resource.data.shopId);
    }

    match /admin_notifications/{id} {
      allow read, delete: if admin(resource.data.shopId);
      allow update: if admin(resource.data.shopId) && changesOnly(['read']);
      allow create: if staff(request.resource.data.shopId) && own(request.resource.data.barberId)
        && request.resource.data.type == 'barber_active' && request.resource.data.read == false;
    }

    match /notifications/{id} {
      allow read: if staff(resource.data.shopId);
      allow update: if staff(resource.data.shopId) && changesOnly(['read']);
    }
  }
}
