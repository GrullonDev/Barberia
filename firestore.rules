rules_version = '2';

// -----------------------------------------------------------------------------
// Barbería — Reglas de seguridad Firestore
//
// Modelo de roles:
//   - client   → usuario final que reserva (web + móvil)
//   - barber   → empleado; ve su agenda y citas asignadas
//   - admin    → dueño; gestiona servicios, barberos, precios, config
//
// Notas:
//   - El rol NO se asigna por orden de registro. Se crea como 'client' por
//     defecto. Admin/barber se promueven manualmente desde un admin existente.
//   - Colecciones "futuras" (schedule_blocks, walkins, reputation, config)
//     ya quedan definidas aquí para evitar re-deploys al activar cada fase.
//   - Cualquier cosa no contemplada se deniega explícitamente al final.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == role;
    }

    function isAdmin()  { return hasRole('admin'); }
    function isBarber() { return hasRole('barber'); }
    function isStaff()  { return isAdmin() || isBarber(); }

    function isOwnerOf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users ---------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwnerOf(userId) || isStaff();

      // Alta: el propio usuario y SOLO como 'client'
      allow create: if isOwnerOf(userId)
                    && request.resource.data.role == 'client';

      // Update propio: no puede cambiarse el rol a sí mismo
      allow update: if isOwnerOf(userId)
                    && request.resource.data.role == resource.data.role;

      // Admin puede todo (promover rol, asignar barbero, etc.)
      allow update, delete: if isAdmin();
    }

    // ---------- services (catálogo público) -----------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- barbers (catálogo público para que el cliente elija) ---------
    match /barbers/{barberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // El barbero puede marcar su propia invitación como aceptada al
      // iniciar sesión por primera vez (solo ese campo, solo a 'active').
      allow update: if isBarber()
                    && request.auth.uid == barberId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['inviteStatus'])
                    && request.resource.data.inviteStatus == 'active';
    }

    // ---------- bookings ------------------------------------------------------
    //
    // CREATE:
    //   Solo staff puede escribir directo por SDK. Los clientes (anónimos
    //   y registrados) reservan por la Cloud Function `reserveSlot`, que
    //   corre con Admin SDK y bypasea estas reglas. Esto garantiza que
    //   siempre se ejecute la transacción anti-colisión del motor de slots.
    //
    // READ / UPDATE:
    //   El dueño del booking (userId) puede leerlo y actualizar ciertos
    //   campos (ej. notes, cancelar). El barbero asignado y los admins/staff
    //   también leen y editan. DELETE queda solo para admin.
    // ------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isStaff()
                  || isOwnerOf(resource.data.userId)
                  || (isBarber() && resource.data.barberId == request.auth.uid);

      allow create: if isStaff();

      allow update: if isStaff()
                    || isOwnerOf(resource.data.userId)
                    || (isBarber() && resource.data.barberId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ---------- schedule_blocks (comida, descanso, vacaciones) ----------------
    match /schedule_blocks/{blockId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin()
        || (isBarber() && request.resource.data.barberId == request.auth.uid);
    }

    // ---------- walkins (cola sin cita) ---------------------------------------
    match /walkins/{walkinId} {
      allow read, write: if isStaff();
    }

    // ---------- reputation (anti no-show, key = teléfono normalizado) ---------
    match /reputation/{phone} {
      allow read, write: if isStaff();
    }

    // ---------- config (horarios, dirección, parámetros globales) -------------
    match /config/{docId} {
      allow read: if true;           // público para mostrar horarios en la web
      allow write: if isAdmin();
    }

    // ---------- default deny --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
